{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kmark",
  "version": "1.0.0",
  "identifier": "com.accou.kmark",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kMark",
        "width": 1280,
        "height": 860,
        "visible": false,
        "minWidth": 50,
        "minHeight": 50
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "JJ5RZN",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown Document",
        "description": "Open Markdown files with kMark"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
