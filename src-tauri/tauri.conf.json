{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kmark",
  "version": "1.0.0",
  "identifier": "com.accou.kmark",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "JJ5RZN",
    "targets": "all",
    "externalBin": [
      "binaries/kmark-mcp"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown Document",
        "description": "Open Markdown files with kMark"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
