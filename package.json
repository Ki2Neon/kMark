{
  "name": "kmark",
  "private": true,
  "version": "1.0.0",
  "author": "JJ5RZN",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.16"
    }
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:rust-core && pnpm run test:frontend-unit",
    "test:rust-core": "cargo test -p kmark-core -p kmark-application",
    "test:frontend-unit": "vitest run --config vitest.unit.config.ts",
    "test:browser": "pnpm run build:wasm && vitest run --config vitest.browser.config.ts",
    "test:tauri": "node tools/run-tauri-e2e.mjs",
    "test:tauri:smoke": "node tools/run-tauri-e2e.mjs --smoke",
    "test:perf": "pnpm run build:wasm && vitest run --config tests/perf/vitest.node.config.ts && vitest run --config tests/perf/vitest.config.ts",
    "test:perf:tauri": "node tools/run-tauri-e2e.mjs --perf",
    "test:ci": "pnpm run build:wasm && pnpm run typecheck && pnpm run lint && cargo fmt --all -- --check && pnpm run build:mcp-sidecar && cargo clippy --workspace --all-targets && pnpm run test:rust && pnpm run test:frontend-unit && pnpm run test:browser && pnpm run test:tauri:smoke",
    "test:all": "pnpm run test:ci && pnpm run test:perf && pnpm run test:perf:tauri",
    "lint": "eslint src && pnpm run check:boundaries && pnpm run check:cycles",
    "build:wasm": "node tools/build-wasm.mjs",
    "build:mcp-sidecar": "node tools/build-mcp-sidecar.mjs",
    "build:desktop": "pnpm run build:mcp-sidecar && pnpm run build",
    "generate:contracts": "node tools/generate-contracts.mjs",
    "check:contracts": "node tools/generate-contracts.mjs --check",
    "dev:vite": "vite",
    "dev": "pnpm run build:wasm && pnpm run dev:vite",
    "build:vite": "pnpm run typecheck && vite build",
    "build:web": "pnpm run build:wasm && pnpm run build:vite",
    "build": "pnpm run build:web",
    "check:boundaries": "node tools/architecture/check-boundaries.mjs",
    "check:cycles": "node tools/architecture/check-cycles.mjs",
    "preview": "vite preview",
    "test:architecture": "node tools/architecture/check-cycles.mjs && node tools/architecture/check-boundaries.mjs && pnpm run check:contracts",
    "test:rust": "pnpm run build:mcp-sidecar && cargo test --workspace",
    "benchmark:rust": "cargo test --manifest-path src-tauri/Cargo.toml benchmark_collect_markdown_file_paths -- --ignored --nocapture",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@plantuml/core": "1.2026.6",
    "@tauri-apps/api": "^2",
    "mermaid": "11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "vitest": "^5.0.2",
    "webdriverio": "^9.32.0"
  }
}
