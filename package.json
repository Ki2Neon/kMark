{
  "name": "kmark",
  "private": true,
  "version": "1.0.0",
  "author": "JJ5RZN",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build:wasm": "node tools/build-wasm.mjs",
    "generate:contracts": "node tools/generate-contracts.mjs",
    "check:contracts": "node tools/generate-contracts.mjs --check",
    "dev:vite": "vite",
    "dev": "pnpm run build:wasm && pnpm run dev:vite",
    "build:vite": "pnpm run test:mermaid-theme && pnpm run test:mermaid-source && pnpm run test:plantuml-core && pnpm run test:plantuml-rendering && pnpm run test:plantuml-stdlib && pnpm run test:plantuml-policy && tsc && vite build",
    "build:web": "pnpm run build:wasm && pnpm run test:plantuml-wasm && pnpm run build:vite",
    "build": "pnpm run build:wasm && pnpm run test:plantuml-wasm && pnpm run build:vite",
    "check:boundaries": "node tools/architecture/check-boundaries.mjs",
    "check:cycles": "node tools/architecture/check-cycles.mjs",
    "preview": "vite preview",
    "test:architecture": "node tools/architecture/check-cycles.mjs && node tools/architecture/check-boundaries.mjs && pnpm run check:contracts",
    "test:mermaid-source": "node --experimental-strip-types --test tools/test-mermaid-source.mjs",
    "test:mermaid-theme": "node --experimental-strip-types --test tools/test-mermaid-theme-contrast.mjs",
    "test:plantuml-core": "node tools/test-plantuml-core-contract.mjs",
    "test:plantuml-rendering": "node --experimental-strip-types tools/test-plantuml-rendering.mjs",
    "test:plantuml-stdlib": "node --experimental-strip-types --test tools/test-plantuml-stdlib.mjs",
    "test:plantuml-wasm": "node --experimental-strip-types tools/test-plantuml-wasm-integration.mjs",
    "test:plantuml-policy": "node --experimental-strip-types --test tools/test-plantuml-policy.mjs",
    "test:editor-scroll": "node --experimental-strip-types --test tools/test-editor-shift-wheel.mjs",
    "test:kmark-completion": "node tools/test-kmark-completion-context.mjs",
    "test:kmark-scope-display": "node tools/test-kmark-scope-display.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "benchmark:rust": "cargo test --manifest-path src-tauri/Cargo.toml benchmark_collect_markdown_file_paths -- --ignored --nocapture",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@plantuml/core": "1.2026.6",
    "@tauri-apps/api": "^2",
    "@uiw/react-codemirror": "^4.25.9",
    "mermaid": "^11.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
