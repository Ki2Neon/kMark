{
  "name": "kmark",
  "private": true,
  "version": "1.0.0",
  "author": "JJ5RZN",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:boundaries": "node tools/architecture/check-boundaries.mjs",
    "check:cycles": "node tools/architecture/check-cycles.mjs",
    "preview": "vite preview",
    "test:architecture": "node tools/architecture/check-cycles.mjs && node tools/architecture/check-boundaries.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "benchmark:rust": "cargo test --manifest-path src-tauri/Cargo.toml benchmark_collect_markdown_file_paths -- --ignored --nocapture",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@uiw/react-codemirror": "^4.25.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
